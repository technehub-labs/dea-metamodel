{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Assessment-Models/dea-catalog-assessment-tools/schemas/instrument.schema.json",
  "title": "DEA Assessment Instrument",
  "description": "Schema for all DEA assessment instruments. Each domain repo (dea-assessment-modernization, dea-assessment-technology, etc.) validates its instrument against this schema.",
  "type": "object",
  "required": ["id", "name", "domain", "version", "metamodel_version", "description", "maturity_target", "dimensions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dea:assessment-[a-z-]+$",
      "description": "Stable ID, used in dea-cli queries"
    },
    "name": { "type": "string" },
    "domain": {
      "type": "string",
      "enum": ["modernization", "technology", "operations", "services-delivery"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z]+)?$"
    },
    "metamodel_version": {
      "type": "string",
      "pattern": "^\\^?[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z]+)?$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "alpha", "beta", "stable", "deprecated"]
    },
    "description": { "type": "string", "minLength": 20 },
    "maturity_target": {
      "type": "string",
      "pattern": "^dea:maturity-[a-z-]+$",
      "description": "Which maturity model this instrument scores"
    },
    "total_questions": { "type": "integer", "minimum": 8, "maximum": 60 },
    "duration_minutes": { "type": "integer", "minimum": 15, "maximum": 240 },
    "facilitator_required": { "type": "boolean" },
    "dimensions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "name", "weight", "questions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "name": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "questions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["id", "text", "scoring", "evidence"],
              "properties": {
                "id": { "type": "string", "pattern": "^q[0-9]+$" },
                "text": { "type": "string", "minLength": 10 },
                "scoring": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 0, "maximum": 3 },
                  "minItems": 4,
                  "maxItems": 4
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "target_id", "relationship_type"],
        "properties": {
          "source_id": { "type": "string" },
          "target_id": { "type": "string" },
          "relationship_type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}