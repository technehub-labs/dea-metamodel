{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/technehub-labs/dea-metamodel/assessment-models/schemas/assessment-execution.schema.json",
  "title": "OpenDEA Assessment Execution",
  "description": "A specific instance of running an AssessmentInstrument against a subject. Produces an AssessmentResult.",
  "type": "object",
  "required": [
    "id",
    "instrument",
    "subject",
    "status",
    "started_at"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "instrument": {
      "$ref": "common.schema.json#/$defs/modelReference"
    },
    "assessment_model": {
      "$ref": "common.schema.json#/$defs/modelReference"
    },
    "subject": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "name": {"type": "string"}
      }
    },
    "scenario": {
      "$ref": "common.schema.json#/$defs/modelReference"
    },
    "assessor": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string", "enum": ["human", "automated", "hybrid"]},
        "name": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/modelReference"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["scheduled", "in-progress", "completed", "aborted", "superseded"]
    },
    "result": {
      "$ref": "common.schema.json#/$defs/modelReference",
      "description": "Identifier of the AssessmentResult produced by this execution."
    }
  },
  "additionalProperties": false
}