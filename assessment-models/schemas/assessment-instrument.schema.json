{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/technehub-labs/dea-metamodel/assessment-models/schemas/assessment-instrument.schema.json",
  "title": "OpenDEA Assessment Instrument",
  "description": "An executable or questionnaire realisation of an AssessmentModel. Implements exactly one AssessmentModel per its contract.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "metamodel_version",
    "type",
    "implements",
    "instrument_type"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "metamodel_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "type": {
      "const": "assessment-instrument"
    },
    "implements": {
      "$ref": "common.schema.json#/$defs/modelReference",
      "description": "The AssessmentModel this instrument implements (e.g. dea:assessment-zero-touch-operations@1.0.0)."
    },
    "instrument_type": {
      "type": "string",
      "enum": [
        "self-assessment",
        "facilitated-workshop",
        "survey",
        "interview",
        "automated",
        "telemetry-driven",
        "hybrid"
      ]
    },
    "description": {
      "type": "string"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/lifecycleStatus"
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "facilitator_required": {
      "type": "boolean"
    },
    "maturity_model": {
      "$ref": "common.schema.json#/$defs/modelReference",
      "description": "The MaturityModel this instrument gathers evidence for (CR-AM-05A §14). The instrument is versioned independently of the maturity model (§15, §32): a new instrument version may add questions without changing the maturity model."
    },
    "sections": {
      "type": "array",
      "description": "Questionnaire organization (CR-AM-05A §23). A Section is organizational/presentation structure — never a semantic hierarchy competing with the Dimension taxonomy.",
      "items": {
        "type": "object",
        "required": ["id", "items"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "description": "AssessmentItem bindings administered in this section.",
            "items": {
              "$ref": "assessment-item.schema.json"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/compatibility"
    }
  },
  "additionalProperties": false
}