{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/technehub-labs/dea-metamodel/assessment-models/schemas/assessment-result.schema.json",
  "title": "OpenDEA Assessment Result",
  "description": "The persistent output of an AssessmentExecution. Stores exact versions of every referenced model. Subsequent model changes do not mutate historical results.",
  "type": "object",
  "required": [
    "id",
    "assessment_model",
    "assessment_instrument",
    "assessment_execution",
    "subject",
    "assessment_period",
    "status",
    "lineage",
    "determinations",
    "maturity_interpretation",
    "compatibility"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "assessment_model": {
      "$ref": "common.schema.json#/$defs/modelReference"
    },
    "assessment_instrument": {
      "$ref": "common.schema.json#/$defs/modelReference"
    },
    "assessment_execution": {
      "$ref": "common.schema.json#/$defs/modelReference"
    },
    "determinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/determination"
      }
    },
    "maturity_interpretation": {
      "$ref": "#/$defs/maturityInterpretation"
    },
    "subject": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "scenario": {
      "$ref": "common.schema.json#/$defs/modelReference"
    },
    "assessment_period": {
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/compatibility"
    },
    "benchmark_eligibility": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "eligible",
            "not-comparable",
            "insufficient-data",
            "provisional"
          ]
        },
        "requirements": {
          "type": "object",
          "properties": {
            "assessment_model": {
              "type": "string"
            },
            "capability": {
              "type": "string"
            },
            "scenario": {
              "type": "string"
            },
            "scoring_model": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            },
            "population": {
              "type": "string"
            },
            "measurement_period": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRecord"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/score"
      }
    },
    "maturity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/maturityResult"
      }
    },
    "benchmark": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/benchmarkResult"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "completed",
        "validated",
        "superseded"
      ]
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    }
  },
  "$defs": {
    "determination": {
      "type": "object",
      "required": [
        "score",
        "maturity_model",
        "maturity_level",
        "finding",
        "confidence",
        "evidence"
      ],
      "properties": {
        "score": {
          "type": "object",
          "required": ["value", "normalized_value", "scale"],
          "properties": {
            "value": {"type": "number"},
            "normalized_value": {"type": "number"},
            "scale": {"type": "string"}
          },
          "additionalProperties": false
        },
        "maturity_model": {
          "$ref": "common.schema.json#/$defs/modelReference"
        },
        "maturity_level": {"type": "integer", "minimum": 1},
        "finding": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRecord"}
        }
      },
      "additionalProperties": false
    },
    "maturityInterpretation": {
      "type": "object",
      "required": ["model", "dimensions", "overall"],
      "properties": {
        "model": {"$ref": "common.schema.json#/$defs/modelReference"},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "level", "score", "confidence"],
            "properties": {
              "id": {"type": "string"},
              "level": {"type": "integer", "minimum": 1},
              "score": {"type": "number"},
              "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
            },
            "additionalProperties": false
          }
        },
        "overall": {
          "type": "object",
          "required": ["level", "method", "rationale"],
          "properties": {
            "level": {"type": "integer", "minimum": 1},
            "method": {
              "type": "string",
              "enum": ["min", "average", "weighted-average", "threshold", "dominant-level", "custom"]
            },
            "rationale": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidenceRecord": {
      "type": "object",
      "required": ["id", "version", "description", "confidence"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "version": {"$ref": "common.schema.json#/$defs/version"},
        "description": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "measure",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "measure": {
          "$ref": "common.schema.json#/$defs/modelReference"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/modelReference"
          }
        }
      }
    },
    "score": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "dimension": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "value": {
          "type": "number"
        },
        "normalized_value": {
          "type": "number"
        },
        "scale": {
          "type": "string"
        }
      }
    },
    "maturityResult": {
      "type": "object",
      "required": [
        "model",
        "level"
      ],
      "properties": {
        "model": {
          "$ref": "common.schema.json#/$defs/modelReference"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "benchmarkResult": {
      "type": "object",
      "required": [
        "model",
        "status"
      ],
      "properties": {
        "model": {
          "$ref": "common.schema.json#/$defs/modelReference"
        },
        "status": {
          "enum": [
            "eligible",
            "not-comparable",
            "insufficient-data",
            "provisional"
          ]
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "description": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        }
      }
    }
  }
}
