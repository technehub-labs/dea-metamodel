{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Assessment-Models/dea-metamodel/schemas/capability.schema.json",
  "title": "OpenDEA Capability",
  "description": "What an organisation or entity is able to do, independently of how that capability is assessed. Reusable across many assessments.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "metamodel_version",
    "type"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "metamodel_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "type": {
      "const": "capability"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/lifecycleStatus"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/identifier"},
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/modelReference"
      },
      "description": "Other capabilities this capability depends on."
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage"
    },
    "compatibility": {
      "$ref": "common.schema.json#/$defs/compatibility"
    }
  },
  "additionalProperties": false
}