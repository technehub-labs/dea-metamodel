!theme plain
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 90
skinparam dpi 96
skinparam maxMessageSize 200
skinparam defaultFontName Arial
!pragma layout elk
skinparam class {
    BackgroundColor #0d1117
    FontColor       #e6edf3
    BorderColor     #2dd4bf
    ArrowColor      #2dd4bf
}
skinparam arrow {
    Color     #2dd4bf
    FontColor #8b949e
    FontStyle italic
}

