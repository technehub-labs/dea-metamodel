{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/action.json",
  "metamodel_version": "1.0.0",
  "title": "Action",
  "description": "A unit of execution that follows from a Decision (CR-7 §13). Decision ≠ Action: 'approve migration' vs 'execute migration'. Performed by an Actor or Agent (§65) within authority and policy boundaries; reversibility is explicit (§41) and drives control strictness.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:action-"
    },
    "type": {
      "type": "string",
      "const": "Action"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "action_kind": {
      "type": "string"
    },
    "decision_ref": {
      "type": "string"
    },
    "reversibility": {
      "type": "string",
      "enum": [
        "reversible",
        "irreversible",
        "conditionally-reversible"
      ]
    },
    "materiality": {
      "type": "string",
      "description": "e.g. financial, external, safety, legal — drives control strictness (§41)."
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
