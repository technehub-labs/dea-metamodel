{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/agent-profile.json",
  "metamodel_version": "1.0.0",
  "title": "AgentProfile",
  "description": "The formal profile of an Agent (CR-7 §22): purpose, objectives, capabilities, knowledge, models, tools, policies, authority, decision/action scope, autonomy level, human oversight, memory, state, inputs, outputs, risks, controls, owner and lifecycle — placed inside the DEA semantic model rather than an isolated template.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:agent-profile-"
    },
    "type": {
      "type": "string",
      "const": "AgentProfile"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "agent_ref": {
      "type": "string"
    },
    "decision_scope": {
      "type": "string"
    },
    "action_scope": {
      "type": "string"
    },
    "human_oversight_ref": {
      "type": "string"
    },
    "risk_profile": {
      "type": "string",
      "description": "G012: risk profile for control strictness."
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
