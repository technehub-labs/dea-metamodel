{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/agent.json",
  "metamodel_version": "1.0.0",
  "title": "Agent",
  "description": "An autonomous or semi-autonomous actor capable of perceiving information, reasoning or evaluating conditions, and initiating or executing actions within a defined authority and policy boundary (CR-7 §20). Broader than 'AI model' (§21): an Agent has identity, purpose, capabilities, knowledge, tools, policies, authority, goals, state, memory, decision mechanism, actions and observability. An Agent is a participant in the enterprise semantic system — not its center (§1).",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:agent-"
    },
    "type": {
      "type": "string",
      "const": "Agent"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "agent_type": {
      "type": "string",
      "enum": [
        "human",
        "organizational",
        "software",
        "ai",
        "autonomous-system",
        "composite"
      ]
    },
    "purpose": {
      "type": "string",
      "maxLength": 2000
    },
    "autonomy_level_ref": {
      "type": "string"
    },
    "owner_ref": {
      "type": "string",
      "description": "G007: accountable owner."
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
