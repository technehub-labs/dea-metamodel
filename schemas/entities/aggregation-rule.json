{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/aggregation-rule.json",
  "metamodel_version": "1.0.0",
  "title": "AggregationRule",
  "description": "Declares how lower-level results combine into higher-level results (CR-5 §25): weighted averages, minimum thresholds, gating criteria, ceilings, qualitative judgement, evidence sufficiency or rule-based scoring. Never assumed to be a simple arithmetic mean (A009).",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:aggregation_rule-"
    },
    "type": {
      "type": "string",
      "const": "AggregationRule"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "rule_kind": {
      "type": "string",
      "enum": [
        "weighted-average",
        "minimum-threshold",
        "gating",
        "ceiling",
        "qualitative-judgement",
        "evidence-sufficiency",
        "rule-based"
      ]
    },
    "operator": {
      "type": "string",
      "enum": [
        "SUM",
        "COUNT",
        "MIN",
        "MAX",
        "MEAN",
        "WEIGHTED_MEAN",
        "MEDIAN",
        "PERCENTILE",
        "RATE",
        "RATIO",
        "DISTINCT_COUNT"
      ],
      "description": "The aggregation operator (CR-MET-005). 11-value enum per the user-supplied binding section 6."
    },
    "weight_basis": {
      "type": "string",
      "maxLength": 500,
      "description": "Required when operator is WEIGHTED_MEAN; the basis for the weighting (e.g. 'numerator_denominator', 'population_size', 'time_period'). CR-MET-005 binding cross-field invariant."
    },
    "unit_semantics": {
      "type": "object",
      "description": "The input and output unit references for the aggregation (CR-MET-005).",
      "properties": {
        "input_unit_ref": {
          "type": "string"
        },
        "output_unit_ref": {
          "type": "string"
        }
      }
    },
    "weights": {
      "type": "object",
      "description": "Optional criterion/dimension weight map."
    },
    "expression": {
      "type": "string",
      "maxLength": 2000
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
