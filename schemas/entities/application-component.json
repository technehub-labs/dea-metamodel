{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/application-component.json",
  "metamodel_version": "0.12.0",
  "title": "ApplicationComponent",
  "description": "A deployable unit of an application system (a service, batch job, scheduled task). A subClass of SolutionComponent with component_type='application'. Catalog: technehub-labs/dea-catalog-application-components.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "const": "ApplicationComponent"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "deployment_unit": {
      "type": "string",
      "enum": [
        "service",
        "batch-job",
        "scheduled-task",
        "event-handler",
        "lambda",
        "daemon"
      ],
      "description": "How this application component is deployed and executed."
    },
    "runtime": {
      "type": "string",
      "description": "Runtime environment (JVM 21, Node 24, Python 3.12, etc.)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
