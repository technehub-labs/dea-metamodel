{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/assessment-gap.json",
  "metamodel_version": "1.0.0",
  "title": "AssessmentGap",
  "description": "The derived difference between a current result and a target (CR-5 §30). Gaps are derived, never authoritative source data; the authoritative data are current state and target state. Gaps connect assessment to transformation via addressed-by → Change (CR-5 §31).",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:assessment_gap-"
    },
    "type": {
      "type": "string",
      "const": "AssessmentGap"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "subject_ref": {
      "type": "string"
    },
    "current_result_ref": {
      "type": "string"
    },
    "target_ref": {
      "type": "string"
    },
    "gap_value": {
      "type": "number"
    },
    "derived": {
      "type": "boolean",
      "const": true,
      "description": "CR-5 §30: gaps are always derived."
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
