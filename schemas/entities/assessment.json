{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/assessment.json",
  "metamodel_version": "1.0.0",
  "title": "Assessment",
  "description": "A structured evaluation of one or more subjects against an assessment framework at a defined point or period in time (CR-5 \u00a74). The evaluation event \u2014 never an attribute of the subject.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:assessment-"
    },
    "type": {
      "type": "string",
      "const": "Assessment"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "framework_ref": {
      "type": "string",
      "description": "Reference to the AssessmentFramework this assessment is conducted under (A001: exactly one)."
    },
    "scope_ref": {
      "type": "string",
      "description": "Reference to the AssessmentScope bounding this assessment (CR-5 \u00a715)."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessor": {
      "type": "string",
      "description": "Actor, team or system performing the assessment."
    },
    "assessment_status": {
      "type": "string",
      "enum": [
        "planned",
        "in-progress",
        "completed",
        "superseded",
        "withdrawn"
      ]
    },
    "methodology": {
      "type": "string",
      "maxLength": 2000
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
