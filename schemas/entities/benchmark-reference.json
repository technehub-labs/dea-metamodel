{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/benchmark-reference.json",
  "metamodel_version": "1.0.0",
  "title": "BenchmarkReference",
  "description": "A specific comparative value drawn from a benchmark population (CR-5 §28): industry level, peer median, percentile. Compared against results via benchmarked-against — never treated as a result (A011).",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:benchmark_reference-"
    },
    "type": {
      "type": "string",
      "const": "BenchmarkReference"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "benchmark_ref": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "percentile": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "criterion_ref": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
