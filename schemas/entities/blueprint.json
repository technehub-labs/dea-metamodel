{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/blueprint.json",
  "metamodel_version": "0.10.0",
  "title": "Blueprint",
  "description": "A composed, reusable target-state design assembled from Architecture Patterns, providing a template for solution design. Renamed from Reference Model in v0.4.0 (ADR-0004 D5). Catalog: technehub-labs/dea-catalog-blueprints.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "domain",
    "abstraction_level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:blueprint-digital-platform"
      ]
    },
    "type": {
      "type": "string",
      "const": "Blueprint"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "examples": [
        "Digital Platform Blueprint"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "domain": {
      "type": "string",
      "enum": [
        "integration",
        "data",
        "application",
        "infrastructure",
        "security",
        "business",
        "technology"
      ],
      "description": "Primary domain."
    },
    "abstraction_level": {
      "type": "string",
      "enum": [
        "conceptual",
        "logical",
        "physical"
      ],
      "description": "Abstraction level of this blueprint."
    },
    "scope": {
      "type": "string",
      "maxLength": 1000,
      "description": "What the blueprint covers and boundaries."
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
