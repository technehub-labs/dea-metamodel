{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/reference-model.json",
  "title": "ReferenceModel",
  "description": "A reference architecture model serving as a template for concrete architectures.",
  "type": "object",
  "required": ["id", "name", "type", "version", "domain", "abstraction_level"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": ["dea:refmodel-digital-platform"]
    },
    "type": { "type": "string", "const": "ReferenceModel" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "examples": ["Digital Platform Reference Architecture"]
    },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "domain": {
      "type": "string",
      "enum": ["integration", "data", "application", "infrastructure",
               "security", "business", "technology"],
      "description": "Primary domain."
    },
    "abstraction_level": {
      "type": "string",
      "enum": ["conceptual", "logical", "physical"],
      "description": "Abstraction level of this reference model."
    },
    "scope": {
      "type": "string",
      "maxLength": 1000,
      "description": "What the model covers and boundaries."
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "key_components": {
      "type": "array",
      "items": { "type": "string" },
      "description": "SolutionComponent IDs that define this reference model."
    },
    "patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ArchitecturePattern IDs used in this model."
    },
    "related_reference_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_standards": { "type": "array", "items": { "type": "string" } },
    "related_principles": { "type": "array", "items": { "type": "string" } },
    "relationships": {
      "type": "array",
      "items": { "$ref": "../relationships/relationship-instance.json" }
    },
    "metadata": { "$ref": "entity.json#/properties/metadata" }
  }
}
