{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/business-capability.json",
  "metamodel_version": "1.0.0",
  "title": "Business Capability",
  "description": "A business capability that an enterprise possesses or requires to produce, enable, control, preserve or realize a meaningful business outcome. Specialization of dea:Capability per ADR-015 / CR-MM-02. The entity type (BusinessCapability) carries the kind information that the deprecated capability_type string used to carry.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:capability-customer-data-management"
      ]
    },
    "type": {
      "type": "string",
      "const": "BusinessCapability"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "capability_layer": {
      "type": "string",
      "enum": [
        "strategic",
        "operational",
        "support"
      ],
      "description": "Abstraction level of the capability (ADR-015 section 5): strategic, operational, or support. Governed enumeration attribute; orthogonal to kind (entity type) and to ECF coordinates."
    },
    "domain": {
      "type": "string",
      "description": "Business domain this capability belongs to.",
      "examples": [
        "Customer",
        "Finance",
        "Supply Chain",
        "HR"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  },
  "examples": [
    {
      "id": "dea:capability-customer-data-management",
      "type": "BusinessCapability",
      "name": "Customer Data Management",
      "version": "1.0.0",
      "capability_layer": "operational",
      "description": "The ability to manage customer data as a governed business asset."
    }
  ]
}