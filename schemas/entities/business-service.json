{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/business-service.json",
  "title": "BusinessService",
  "description": "A service exposed to the business or to external consumers.",
  "type": "object",
  "required": ["id", "name", "type", "version", "service_type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": ["dea:service-customer-onboarding"]
    },
    "type": { "type": "string", "const": "BusinessService" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "service_type": {
      "type": "string",
      "enum": ["internal", "external", "partner", "public"],
      "description": "Service exposure scope."
    },
    "owner": { "type": "string" },
    "provided_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "SolutionComponent IDs that provide this service."
    },
    "consumed_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "SolutionComponent or Process IDs that consume this service."
    },
    "sla": {
      "type": "object",
      "properties": {
        "availability": { "type": "string" },
        "latency_p99_ms": { "type": "integer" },
        "throughput_rps": { "type": "integer" }
      }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "../relationships/relationship-instance.json" }
    },
    "metadata": { "$ref": "entity.json#/properties/metadata" }
  }
}
