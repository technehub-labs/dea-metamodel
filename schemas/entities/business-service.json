{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/business-service.json",
  "metamodel_version": "1.0.0",
  "title": "BusinessService",
  "description": "A service exposed to the business or to external consumers.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "service_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:service-customer-onboarding"
      ]
    },
    "type": {
      "type": "string",
      "const": "BusinessService"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "service_type": {
      "type": "string",
      "enum": [
        "internal",
        "external",
        "partner",
        "public"
      ],
      "description": "Service exposure scope."
    },
    "sla": {
      "type": "object",
      "properties": {
        "availability": {
          "type": "string"
        },
        "latency_p99_ms": {
          "type": "integer"
        },
        "throughput_rps": {
          "type": "integer"
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
