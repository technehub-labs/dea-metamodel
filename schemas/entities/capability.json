{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/capability.json",
  "title": "Capability",
  "description": "A business or technical capability that the enterprise possesses or requires.",
  "type": "object",
  "required": ["id", "name", "type", "version", "capability_type", "maturity_level"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": ["dea:capability-customer-data-management"]
    },
    "type": { "type": "string", "const": "Capability" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "capability_type": {
      "type": "string",
      "enum": ["business", "technical", "hybrid"],
      "description": "Nature of the capability."
    },
    "domain": {
      "type": "string",
      "description": "Business domain this capability belongs to.",
      "examples": [["Customer", "Finance", "Supply Chain", "HR"]]
    },
    "maturity_level": {
      "type": "string",
      "enum": ["nascent", "emerging", "defined", "managed", "optimizing"],
      "description": "CMMI-style maturity assessment."
    },
    "owner": {
      "type": "string",
      "description": "Role or team responsible for this capability."
    },
    "parent_capability": {
      "type": "string",
      "description": "ID of parent Capability in the capability hierarchy."
    },
    "child_capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of child Capabilities."
    },
    "realized_by": {
      "type": "array",
      "items": { "type": "string" },
      "description": "SolutionComponent IDs that realize this capability."
    },
    "processes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Process IDs that deliver this capability."
    },
    "metrics": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Metric IDs that measure this capability."
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "../relationships/relationship-instance.json" }
    },
    "metadata": { "$ref": "entity.json#/properties/metadata" }
  }
}
