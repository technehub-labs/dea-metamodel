{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/capability.json",
  "metamodel_version": "0.9.0",
  "title": "Capability",
  "description": "A business or technical capability that the enterprise possesses or requires.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "capability_type",
    "maturity_level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:capability-customer-data-management"
      ]
    },
    "type": {
      "type": "string",
      "const": "Capability"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "capability_type": {
      "type": "string",
      "enum": [
        "business",
        "technical",
        "hybrid"
      ],
      "description": "Nature of the capability."
    },
    "domain": {
      "type": "string",
      "description": "Business domain this capability belongs to.",
      "examples": [
        [
          "Customer",
          "Finance",
          "Supply Chain",
          "HR"
        ]
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
