{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/change-initiative.json",
  "metamodel_version": "0.6.0",
  "title": "ChangeInitiative",
  "description": "A deliberate effort to shift Skills, Roles, or culture within an Organizational Unit, typically funded by an Investment Initiative. OpenDEAM v0.3.0 (ADR-0003), L3/People, Skills & Culture.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:change-initiative-example"
      ]
    },
    "type": {
      "type": "string",
      "const": "ChangeInitiative"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "change_scope": {
      "type": "string",
      "enum": [
        "skills",
        "roles",
        "culture",
        "structure"
      ],
      "description": "Primary target of the change."
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Organizational Unit ids targeted."
    },
    "funded_by": {
      "type": "string",
      "description": "Investment Initiative id funding this change."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
