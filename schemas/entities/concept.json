{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/concept.json",
  "metamodel_version": "0.6.0",
  "title": "Concept",
  "description": "A canonical, definable unit of meaning (business term or classification node) that other entities link to via defined_by. Merged from Glossary Term + Taxonomy Node in v0.4.0 (ADR-0004 D2) — a queryable concept graph, not a static glossary document. Dimension entity of orthogonal_allocators.semantic-dimension. Catalog: technehub-labs/dea-catalog-concepts.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "definition"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:concept-microservice"
      ]
    },
    "type": {
      "type": "string",
      "const": "Concept"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$"
    },
    "definition": {
      "type": "string",
      "maxLength": 1000,
      "description": "Canonical definition of this concept."
    },
    "abbreviation": {
      "type": "string",
      "maxLength": 20,
      "description": "Common abbreviation.",
      "examples": [
        [
          "MSA",
          "API",
          "ESB"
        ]
      ]
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternative names for this concept."
    },
    "parent_concept": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID of the parent Concept in the concept graph (null/omitted = root). Replaces TaxonomyNode's tree structure (ADR-0004 D2)."
    },
    "related_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of related Concepts (non-hierarchical links)."
    },
    "defines_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Entity IDs across L1-L5 that carry defined_by pointing at this Concept."
    },
    "usage_context": {
      "type": "string",
      "maxLength": 500,
      "description": "When and how to use this concept."
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
