{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/control.json",
  "title": "Control",
  "description": "A mechanism (process, technical, or organizational) that mitigates a Risk or enforces a Regulation. OpenDEAM v0.3.0 (ADR-0003), L2/Risk & Compliance.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:control-example"
      ]
    },
    "type": {
      "type": "string",
      "const": "Control"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "control_type": {
      "type": "string",
      "enum": [
        "preventive",
        "detective",
        "corrective"
      ],
      "description": "Control mechanism class."
    },
    "mitigates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Risk ids this control mitigates."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
