{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/decision.json",
  "metamodel_version": "0.12.0",
  "title": "Decision",
  "description": "A determination made by an Actor, system or Agent that selects or authorizes a course of action based on information, rules, objectives and constraints (CR-4 §13). Foundation for agentic architecture (CR-7).",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:decision-"
    },
    "type": {
      "type": "string",
      "const": "Decision"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "statement": {
      "type": "string",
      "maxLength": 2000,
      "description": "The decision statement in natural language."
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    },
    "rationale": {
      "type": "string",
      "maxLength": 4000,
      "description": "CR-7 §11: why this option was selected (G002)."
    },
    "authority_ref": {
      "type": "string",
      "description": "CR-7 §18; G001: the Authority under which the decision was made."
    },
    "confidence": {
      "type": "object",
      "description": "CR-7 §17: decision confidence.",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "uncertainty": {
      "type": "string",
      "maxLength": 2000,
      "description": "CR-7 §17: known uncertainty, e.g. cost estimate ±20%."
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CR-7 §17: assumptions the decision rests on."
    }
  }
}
