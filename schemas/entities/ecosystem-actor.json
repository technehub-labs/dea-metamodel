{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/ecosystem-actor.json",
  "metamodel_version": "0.6.0",
  "title": "Ecosystem Actor",
  "description": "External party that actively exchanges value with the enterprise — supplier, customer, regulator, partner. OpenDEAM v0.2.0, L1 Ecosystem & Value Network / External Parties. Distinct from Stakeholder (affected/engaged, may be passive): an Ecosystem Actor is defined by an active value-exchange relationship.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "actor_kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:ecosystem-actor-acme-bank"
      ]
    },
    "type": {
      "type": "string",
      "const": "EcosystemActor"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "actor_kind": {
      "type": "string",
      "enum": [
        "customer",
        "supplier",
        "partner",
        "regulator",
        "platform",
        "competitor"
      ],
      "description": "The primary exchange role the actor plays in the enterprise's value network."
    },
    "exchange_directions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "inbound",
          "outbound"
        ]
      },
      "description": "Directions of value flow between this actor and the enterprise."
    },
    "digital_identity_ref": {
      "type": "string",
      "description": "Reference to the Digital Identity representing this actor (EA → DI realization)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
