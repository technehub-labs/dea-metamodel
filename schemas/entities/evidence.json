{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/evidence.json",
  "metamodel_version": "0.10.0",
  "title": "Evidence",
  "description": "First-class support for an assessment result (CR-5 \u00a716): document, inventory, interview, survey, metric, audit report, process observation, system log, API measurement or control test \u2014 with provenance, validity and confidence. Evidence supports a result; it is not the result (CR-5 \u00a717).",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:evidence-"
    },
    "type": {
      "type": "string",
      "const": "Evidence"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "document",
        "inventory",
        "interview",
        "survey",
        "metric",
        "audit-report",
        "process-observation",
        "system-log",
        "api-measurement",
        "control-test"
      ]
    },
    "source_ref": {
      "type": "string",
      "description": "Reference to the EvidenceSource."
    },
    "reference": {
      "type": "string",
      "description": "Locator for the evidence (URI, document id, system path)."
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_by": {
      "type": "string"
    },
    "validity": {
      "type": "string",
      "description": "Validity window or qualifier for the evidence."
    },
    "confidence": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
