{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/glossary-term.json",
  "title": "GlossaryTerm",
  "description": "A controlled vocabulary term with definition and cross-references.",
  "type": "object",
  "required": ["id", "name", "type", "version", "definition"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": ["dea:term-microservice"]
    },
    "type": { "type": "string", "const": "GlossaryTerm" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "definition": {
      "type": "string",
      "maxLength": 1000,
      "description": "Canonical definition of this term."
    },
    "abbreviation": {
      "type": "string",
      "maxLength": 20,
      "description": "Common abbreviation.",
      "examples": [["MSA", "API", "ESB"]]
    },
    "synonyms": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternative names for this term."
    },
    "antonyms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_terms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metamodel_entity": {
      "type": "string",
      "description": "The metamodel Entity type this term maps to.",
      "examples": [["SolutionComponent", "ArchitecturePattern", "Capability"]]
    },
    "usage_context": {
      "type": "string",
      "maxLength": 500,
      "description": "When and how to use this term."
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "../relationships/relationship-instance.json" }
    },
    "metadata": { "$ref": "entity.json#/properties/metadata" }
  }
}
