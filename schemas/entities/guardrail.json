{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/standard.json",
  "title": "Standard",
  "description": "A referenced industry standard or framework (TOGAF, Zachman, ISO, IEEE, etc.).",
  "type": "object",
  "required": ["id", "name", "type", "version", "standard_body", "domain"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": ["dea:standard-togaf-91"]
    },
    "type": { "type": "string", "const": "Standard" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "examples": ["The Open Group Architecture Framework (TOGAF)"]
    },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string" },
    "standard_body": {
      "type": "string",
      "maxLength": 100,
      "examples": [["The Open Group", "ISO", "IEEE", "NIST"]]
    },
    "domain": {
      "type": "string",
      "enum": ["enterprise-architecture", "data-architecture", "software-architecture",
               "security-architecture", "cloud-architecture", "integration-architecture",
               "process-architecture", "governance"],
      "description": "Primary domain this standard applies to."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URL to the standard's documentation."
    },
    "license": {
      "type": "string",
      "maxLength": 100,
      "examples": [["TOGAF", "Zachman", "ISO/IEC/IEEE 42010", "MIT"]]
    },
    "coverage": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Aspects covered: framework, methodology, ontology, notation, etc."
    },
    "conforms_to": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Standards this one references or builds upon."
    },
    "related_patterns": { "type": "array", "items": { "type": "string" } },
    "related_principles": { "type": "array", "items": { "type": "string" } },
    "relationships": {
      "type": "array",
      "items": { "$ref": "../relationships/relationship-instance.json" }
    },
    "metadata": { "$ref": "entity.json#/properties/metadata" }
  }
}
