{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/metric.json",
  "metamodel_version": "1.0.0",
  "title": "Metric",
  "description": "A formally defined, reusable semantic specification that describes a measurable property, characteristic, condition, quantity, rate, ratio, index, or other observable aspect of a subject, including the semantic rules necessary to determine and interpret its value. A Metric is foundational: reified across the measurement-dimension orthogonal allocator (ADR-0002 D1) and referenceable from any OpenDEAM profile. (CR-MET-001 binding CR-MET-000 reconciliation and ADR-MET-001.)",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "subject_concept",
    "measurement_nature"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:metric-api-adoption-rate"
      ]
    },
    "type": {
      "type": "string",
      "const": "Metric"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "subject_concept": {
      "type": "string",
      "description": "The type of phenomenon or property measured (CR-MET-001 binding). Normative: required, distinguishes a Metric by what it measures rather than by its MECE label.",
      "examples": [
        "dea:subject-revenue",
        "dea:subject-customer-retention",
        "dea:subject-availability"
      ]
    },
    "measurement_nature": {
      "type": "string",
      "enum": [
        "numeric",
        "ordinal",
        "nominal",
        "boolean",
        "composite"
      ],
      "description": "The data nature of the value produced by applying this Metric. Normative: required. CR-MET-001 binding."
    },
    "subject_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dea:subject-financial",
          "dea:subject-customer",
          "dea:subject-organizational",
          "dea:subject-operational",
          "dea:subject-technology",
          "dea:subject-data",
          "dea:subject-risk",
          "dea:subject-capability",
          "dea:subject-strategic",
          "dea:subject-sustainability"
        ]
      },
      "description": "Measurement subject axis (CR-MET-002 binding ADR-MET-003). A Metric MAY have multiple subject classifications; a non-empty value is recommended for catalog discoverability."
    },
    "purpose_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "performance_measurement",
          "risk_monitoring",
          "compliance_monitoring",
          "quality_measurement",
          "efficiency_measurement",
          "effectiveness_measurement",
          "maturity_measurement",
          "outcome_measurement",
          "diagnostic_measurement",
          "predictive_measurement"
        ]
      },
      "description": "Measurement purpose axis (CR-MET-002 binding ADR-MET-003). A Metric MAY have multiple purpose classifications."
    },
    "orientation_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "leading",
          "lagging",
          "diagnostic",
          "concurrent"
        ]
      },
      "description": "Measurement orientation axis (CR-MET-002 binding ADR-MET-003). Mirrors Indicator.kind. A Metric MAY have multiple orientation classifications only where the definitions genuinely support them."
    },
    "scope_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "enterprise",
          "business_domain",
          "business_unit",
          "organizational_unit",
          "value_stream",
          "capability",
          "process",
          "product_or_service",
          "system_or_component",
          "individual_subject"
        ]
      },
      "description": "Measurement scope axis (CR-MET-002 binding ADR-MET-003). A Metric MAY have multiple scope classifications. process refers to dea:BusinessProcess (line 592; L3); there is no dea:Activity (per user reminder 2026-10-18)."
    },
    "formula_definition": {
      "type": "object",
      "description": "The structured calculation definition (CR-MET-005 binding). 8-field object per user-supplied section 5.",
      "required": [
        "expression",
        "inputs",
        "unit_semantics",
        "version"
      ],
      "properties": {
        "formula_id": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "maxLength": 4000
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "source_ref",
              "measurement_nature"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "measurement_nature": {
                "type": "string",
                "enum": [
                  "numeric",
                  "ordinal",
                  "nominal",
                  "boolean",
                  "composite"
                ]
              }
            }
          }
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value_type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value_type": {
                "type": "string"
              },
              "default_value": {}
            }
          }
        },
        "unit_semantics": {
          "type": "object",
          "required": [
            "output_unit"
          ],
          "properties": {
            "input_units": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "output_unit": {
              "type": "string"
            }
          }
        },
        "validation_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "composite_definition": {
      "type": "object",
      "description": "The structured Composite Metric definition (CR-MET-005 binding). 6-field object per user-supplied section 7. Required iff measurement_nature: composite.",
      "required": [
        "component_metrics",
        "normalization_method",
        "missing_component_treatment",
        "aggregation_method",
        "output_unit_or_scale"
      ],
      "properties": {
        "component_metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric_ref",
              "weight"
            ],
            "properties": {
              "metric_ref": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "contribution_type": {
                "type": "string",
                "enum": [
                  "linear",
                  "multiplicative",
                  "threshold",
                  "custom"
                ]
              }
            }
          }
        },
        "normalization_method": {
          "type": "string",
          "enum": [
            "none",
            "min-max",
            "z-score",
            "rank",
            "custom"
          ]
        },
        "missing_component_treatment": {
          "type": "string",
          "enum": [
            "fail",
            "impute",
            "reweight",
            "zero",
            "undefined"
          ]
        },
        "aggregation_method": {
          "type": "string",
          "enum": [
            "SUM",
            "COUNT",
            "MIN",
            "MAX",
            "MEAN",
            "WEIGHTED_MEAN",
            "MEDIAN",
            "PERCENTILE",
            "RATE",
            "RATIO",
            "DISTINCT_COUNT"
          ]
        },
        "output_unit_or_scale": {
          "type": "string"
        },
        "calculation_lineage": {
          "type": "string",
          "description": "Reference to the lineage record; the full lineage model is CR-MET-011."
        }
      }
    },
    "precision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "Significant figures for the result (CR-MET-005 binding)."
    },
    "decimal_scale": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "description": "Decimal places for the result (CR-MET-005 binding)."
    },
    "rounding_rule": {
      "type": "string",
      "enum": [
        "half_up",
        "half_even",
        "half_down",
        "truncate"
      ],
      "description": "Rounding rule for the result (CR-MET-005 binding). 4-value enum."
    },
    "null_value_semantics": {
      "type": "string",
      "maxLength": 500,
      "description": "How null/missing values are interpreted (CR-MET-005 binding). Examples: 'excluded_from_aggregation', 'treated_as_zero', 'propagates_null'."
    },
    "management_significance": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "general_metric",
          "kpi",
          "kri",
          "kci",
          "sli",
          "other_governed_designation"
        ]
      },
      "description": "Management significance axis (CR-MET-002 binding ADR-MET-003). Designations, not specializations. Full IndicatorDesignation entity in CR-MET-008."
    },
    "directionality": {
      "type": "string",
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "target_is_better",
        "nominal"
      ],
      "description": "Desired interpretation of increasing or decreasing values. CR-MET-001 binding."
    },
    "calculation_definition": {
      "type": "string",
      "maxLength": 2000,
      "description": "Formula or computational definition. Required when measurement_nature is numeric and the value is computed; for ordinal/nominal/boolean values a textual rule suffices."
    },
    "unit": {
      "type": "string",
      "description": "Measurement unit (cross-reference to the unit registry per CR-MET-005). Optional: required only when measurement_nature is numeric. Examples: %, count, days, USD, ms.",
      "examples": [
        "%",
        "count",
        "days",
        "USD",
        "ms"
      ]
    },
    "measurement_method": {
      "type": "string",
      "maxLength": 2000,
      "description": "How this metric is collected or calculated."
    },
    "baseline_value": {
      "type": [
        "number",
        "string"
      ]
    },
    "target_value": {
      "type": [
        "number",
        "string"
      ]
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "red": {
          "type": [
            "number",
            "string"
          ]
        },
        "amber": {
          "type": [
            "number",
            "string"
          ]
        },
        "green": {
          "type": [
            "number",
            "string"
          ]
        }
      }
    },
    "frequency": {
      "type": "string",
      "enum": [
        "realtime",
        "hourly",
        "daily",
        "weekly",
        "monthly",
        "quarterly"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    },
    "scope_layers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^L[0-9]+$"
      },
      "description": "Architecture layers this metric may evaluate (OpenDEAM v0.2.0 measurement-dimension scope)."
    },
    "legacy_metric_type": {
      "type": "string",
      "enum": [
        "kpi",
        "health",
        "maturity",
        "performance",
        "adoption",
        "compliance",
        "risk"
      ],
      "description": "DEPRECATED. The pre-CR-MET-001 MECE taxonomy value. Preserved for one release cycle to allow migration of existing catalog records. New records MUST use the binding six-axis classification per CR-MET-002 / ADR-MET-003."
    }
  }
}
