{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/policy-evaluation.json",
  "metamodel_version": "1.0.0",
  "title": "PolicyEvaluation",
  "description": "The evaluation of an action or subject against a policy (CR-7 §38): policy, subject, action, context, result, reason, timestamp. Produces a PolicyDecision (§39).",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "description": "Stable OpenDEA identifier (CR-3Q). Type prefix: dea:policy-evaluation-"
    },
    "type": {
      "type": "string",
      "const": "PolicyEvaluation"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "policy_ref": {
      "type": "string"
    },
    "subject_ref": {
      "type": "string"
    },
    "action_ref": {
      "type": "string"
    },
    "context": {
      "type": "string",
      "maxLength": 2000
    },
    "result": {
      "type": "string",
      "enum": [
        "compliant",
        "non-compliant",
        "conditional",
        "not-applicable"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "relationships": {
      "type": "array",
      "description": "Derived convenience view (CR-1/CR-3): canonical relationship instances are authoritative.",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
