{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/process.json",
  "metamodel_version": "0.10.0",
  "title": "Process",
  "description": "A business or operational process that delivers value. Classified by intent (operational/support/management) and audience (ECF domain whose work this most advances); stakeholders and actors are referenced from typed catalogs.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "process_intent",
    "process_audience"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:process-order-management"
      ]
    },
    "type": {
      "type": "string",
      "const": "Process"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "process_intent": {
      "type": "string",
      "enum": [
        "operational",
        "support",
        "management"
      ],
      "description": "The process's role in the enterprise. 'operational' executes defined recurring work; 'support' enables other processes without producing the primary output; 'management' decides, plans, allocates, or governs. See docs/process-type-taxonomy.md for boundary rules."
    },
    "process_audience": {
      "type": "string",
      "enum": [
        "governance-existence",
        "supply-resources",
        "people-organization",
        "customer-demand",
        "product-offering",
        "operations-delivery",
        "finance-value"
      ],
      "description": "The Enterprise Concept Framework (ECF) domain whose work this process most advances. Axiom-derived from the definition of 'enterprise' — see technehub-labs/dea-metaframework REPORT.md §2."
    },
    "trigger": {
      "type": "string",
      "maxLength": 500,
      "description": "What initiates this process."
    },
    "outcome": {
      "type": "string",
      "maxLength": 500,
      "description": "Expected result of process completion."
    },
    "capabilities_delivered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services_provided": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components_involved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
