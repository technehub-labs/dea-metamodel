{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/regulation.json",
  "title": "Regulation",
  "description": "An externally imposed obligation (law, industry standard with force, contractual mandate) the enterprise must comply with. OpenDEAM v0.3.0 (ADR-0003), L2/Risk & Compliance.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:regulation-example"
      ]
    },
    "type": {
      "type": "string",
      "const": "Regulation"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Jurisdiction or authority imposing the obligation."
    },
    "mandates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Control ids required by this regulation."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
