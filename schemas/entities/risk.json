{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/risk.json",
  "metamodel_version": "1.0.0",
  "title": "Risk",
  "description": "A condition or event that threatens the enterprise's ability to persist or to realize a capability/objective. OpenDEAM v0.3.0 (ADR-0003), L2/Risk & Compliance.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:risk-example"
      ]
    },
    "type": {
      "type": "string",
      "const": "Risk"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "risk_category": {
      "type": "string",
      "enum": [
        "strategic",
        "operational",
        "regulatory",
        "technology",
        "financial",
        "reputational"
      ],
      "description": "Risk classification."
    },
    "likelihood": {
      "type": "string",
      "enum": [
        "rare",
        "unlikely",
        "possible",
        "likely",
        "almost-certain"
      ],
      "description": "Assessed likelihood."
    },
    "impact": {
      "type": "string",
      "enum": [
        "negligible",
        "minor",
        "moderate",
        "major",
        "severe"
      ],
      "description": "Assessed impact."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
