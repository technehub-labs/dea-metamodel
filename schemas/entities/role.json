{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/role.json",
  "metamodel_version": "0.6.0",
  "title": "Role",
  "description": "A defined set of required Skills and responsibilities that an Actor fulfills within an Organizational Unit. OpenDEAM v0.3.0 (ADR-0003), L3/People, Skills & Culture.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:role-example"
      ]
    },
    "type": {
      "type": "string",
      "const": "Role"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skill ids required by this role."
    },
    "fulfilled_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actor ids currently fulfilling this role."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
