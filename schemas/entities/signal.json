{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/signal.json",
  "metamodel_version": "0.9.0",
  "title": "Signal",
  "description": "A weak or early indicator of environmental change (market, technology, regulatory, competitive) worth tracking before it forces adaptation. OpenDEAM v0.3.0 (ADR-0003), L2/Innovation & Foresight.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:signal-example"
      ]
    },
    "type": {
      "type": "string",
      "const": "Signal"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "signal_source": {
      "type": "string",
      "enum": [
        "market",
        "technology",
        "regulatory",
        "competitor",
        "customer"
      ],
      "description": "Where the signal originates."
    },
    "strength": {
      "type": "string",
      "enum": [
        "weak",
        "emerging",
        "strong"
      ],
      "description": "Assessed signal strength."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
