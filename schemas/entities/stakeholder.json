{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/stakeholder.json",
  "metamodel_version": "0.9.0",
  "title": "Stakeholder",
  "description": "An external or affected party whose relationship with the enterprise is engaged in or affected by enterprise processes. Stakeholders are NOT internal performers — internal performers (employees, teams, systems, AI agents) are Actors, not Stakeholders. Catalog: technehub-labs/dea-catalog-stakeholders.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version",
    "stakeholder_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:stakeholder-acme-corp"
      ]
    },
    "type": {
      "type": "string",
      "const": "Stakeholder"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "stakeholder_type": {
      "type": "string",
      "enum": [
        "customer",
        "partner",
        "supplier",
        "regulator",
        "investor",
        "community",
        "board"
      ],
      "description": "The relationship class the stakeholder holds with the enterprise. Open set — new stakeholder types (e.g. AI agents, DAO treasuries) can be added without schema changes when enterprise relationships genuinely require them."
    },
    "primary_contact": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../relationships/relationship-instance.json"
      }
    },
    "metadata": {
      "$ref": "entity.json#/properties/metadata"
    }
  }
}
