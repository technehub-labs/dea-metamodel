{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/principle.json",
  "title": "Principle",
  "description": "An architectural guiding principle that governs design and decision-making.",
  "type": "object",
  "required": ["id", "name", "type", "version", "statement", "rationale", "applicability"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": ["dea:principle-api-first"]
    },
    "type": { "type": "string", "const": "Principle" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "examples": ["API-first Design"]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "statement": {
      "type": "string",
      "maxLength": 500,
      "description": "The canonical principle statement (imperative or declarative).",
      "examples": ["All services shall expose their capabilities via a well-defined API before any other integration mechanism."]
    },
    "rationale": {
      "type": "string",
      "maxLength": 2000,
      "description": "Why this principle exists, the problem it solves."
    },
    "applicability": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of contexts/stakeholders this applies to.",
      "examples": [["Solutions Architects", "Integration Engineers", "API Developers"]]
    },
    "exceptions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 500 },
      "description": "Known exceptions to this principle with justification."
    },
    "conflicts_with": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of principles that may conflict with this one.",
      "examples": [["dea:principle-no-code-platforms"]]
    },
    "related_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ArchitecturePattern IDs influenced by or supporting this principle."
    },
    "related_standards": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Standard IDs this principle maps to."
    },
    "tier": {
      "type": "string",
      "enum": ["mandatory", "recommended", "aspirational"],
      "description": "Enforcement level of this principle."
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "../relationships/relationship-instance.json" }
    },
    "metadata": { "$ref": "entity.json#/properties/metadata" }
  }
}
