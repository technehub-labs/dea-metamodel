{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-metamodel/schemas/entities/viewpoint.json",
  "title": "Viewpoint",
  "description": "A filtered perspective on the metamodel for a specific stakeholder or concern.",
  "type": "object",
  "required": ["id", "name", "type", "version", "stakeholder", "concern"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": ["dea:viewpoint-cto-quarterly-review"]
    },
    "type": { "type": "string", "const": "Viewpoint" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "stakeholder": {
      "type": "string",
      "description": "Primary stakeholder this viewpoint serves.",
      "examples": [["CTO", "Chief Architect", "Solutions Architect", "Developer"]]
    },
    "concern": {
      "type": "string",
      "description": "The architectural concern this viewpoint addresses.",
      "examples": [["Quarterly health review", "Compliance assessment", "Integration planning"]]
    },
    "entities_included": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Metamodel entity types shown in this viewpoint."
    },
    "entities_excluded": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relationships_included": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relationship types shown."
    },
    "filter_criteria": {
      "type": "object",
      "description": "Dynamic filters: tags, domains, maturity levels, etc.",
      "additionalProperties": true
    },
    "presentation_format": {
      "type": "string",
      "enum": ["diagram", "table", "matrix", "dashboard", "narrative", "multi"]
    },
    "generated_from": {
      "type": "string",
      "description": "Catalog or repository this viewpoint is generated from."
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "../relationships/relationship-instance.json" }
    },
    "metadata": { "$ref": "entity.json#/properties/metadata" }
  }
}
