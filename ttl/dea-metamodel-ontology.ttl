# DEA Metamodel — OWL/RDF Turtle Serialization
# Version: 0.10.0
# Derived from normative source: metamodel/dea-metamodel.yaml (CR-001).
# Canonical RDF representation of the DEA metamodel ontology.

@prefix dea:    <https://technehub-labs.github.io/dea-metamodel/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .

@prefix deaent: <https://technehub-labs.github.io/dea-metamodel/entities/> .
@prefix dearel: <https://technehub-labs.github.io/dea-metamodel/relationships/> .

# ─── Ontology Declaration ──────────────────────────────────

dea: a owl:Ontology ;
    owl:versionInfo "0.10.0" ;
    rdfs:label "Digital Enterprise Architecture Metamodel" ;
    dct:description "Canonical entity, relationship, and attribute definitions for the DEA catalog ecosystem." ;
    dct:creator "TechneHub Labs" ;
    dct:license <https://opensource.org/licenses/MIT> .

# ─── Core Classes ─────────────────────────────────────────

dea:Entity a owl:Class ;
    rdfs:label "Entity" ;
    skos:definition "Abstract root type for all DEA metamodel entities." ;
    rdfs:isDefinedBy dea: .

dea:Tenet a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Tenet" ;
    skos:definition "A non-binding, human-authored belief that guides decisions and informs Guardrails (renamed from Principle in v0.4.0, ADR-0004 D3)." ;
    dea:specification <schemas/entities/tenet.json> .

dea:ArchitecturePattern a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "ArchitecturePattern" ;
    skos:definition "A reusable architectural pattern that solves a recurring design problem." ;
    dea:specification <schemas/entities/architecture-pattern.json> .

dea:Guardrail a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Guardrail" ;
    skos:definition "An enforceable constraint on technology or solution choices with an enforcement maturity level (renamed from Standard in v0.4.0, ADR-0004 D4)." ;
    dea:specification <schemas/entities/guardrail.json> .

dea:Blueprint a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Blueprint" ;
    skos:definition "A composed, reusable target-state design assembled from Architecture Patterns (renamed from ReferenceModel in v0.4.0, ADR-0004 D5)." ;
    dea:specification <schemas/entities/blueprint.json> .

dea:Capability a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Capability" ;
    skos:definition "A business or technical capability the enterprise possesses or requires." ;
    dea:specification <schemas/entities/capability.json> .

dea:Process a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Process" ;
    skos:definition "A business or operational process that delivers value." ;
    dea:specification <schemas/entities/process.json> .

dea:BusinessObject a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "BusinessObject" ;
    skos:definition "A real-world entity of interest to the business. The atom of the ECF matrix — every (domain, stage) cell contains the business objects currently in that lifecycle state." ;
    dea:specification <schemas/entities/business-object.json> .

dea:OrganizationalUnit a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "OrganizationalUnit" ;
    skos:definition "A unit of organisation (team, division, business unit, governance body, virtual team) that owns capabilities, runs processes, and is custodian for business objects." ;
    dea:specification <schemas/entities/organizational-unit.json> .

dea:Stakeholder a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Stakeholder" ;
    skos:definition "An external or affected party whose relationship with the enterprise is engaged in or affected by enterprise processes. Stakeholders are distinct from Actors (internal performers); external or affected parties are Stakeholders, not Actors." ;
    dea:specification <schemas/entities/stakeholder.json> .

dea:Actor a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Actor" ;
    skos:definition "A performer of enterprise processes — human, team, system, or AI agent. Actors are internal performers; the Employees of the enterprise are modelled as Actors." ;
    dea:specification <schemas/entities/actor.json> .

dea:BusinessService a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "BusinessService" ;
    skos:definition "A service exposed to the business or to external consumers." ;
    dea:specification <schemas/entities/business-service.json> .

dea:SolutionComponent a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "SolutionComponent" ;
    skos:definition "A physical or logical component that implements capabilities." ;
    dea:specification <schemas/entities/solution-component.json> .

dea:ApplicationComponent a owl:Class ;
    rdfs:subClassOf dea:SolutionComponent ;
    rdfs:label "ApplicationComponent" ;
    dea:specification <schemas/entities/application-component.json> .

dea:InfrastructureComponent a owl:Class ;
    rdfs:subClassOf dea:SolutionComponent ;
    rdfs:label "InfrastructureComponent" ;
    dea:specification <schemas/entities/infrastructure-component.json> .

dea:IntegrationComponent a owl:Class ;
    rdfs:subClassOf dea:SolutionComponent ;
    rdfs:label "IntegrationComponent" ;
    dea:specification <schemas/entities/integration-component.json> .

dea:Technology a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Technology" ;
    dea:specification <schemas/entities/technology.json> .

dea:Metric a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Metric" ;
    skos:definition "A measurable indicator used to track EA health and performance." ;
    dea:specification <schemas/entities/metric.json> .

dea:Concept a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Concept" ;
    skos:definition "A canonical, definable unit of meaning other entities link to via defined_by; dimension entity of semantic-dimension (merged from GlossaryTerm + TaxonomyNode in v0.4.0, ADR-0004 D2)." ;
    dea:specification <schemas/entities/concept.json> .

# ─── Relationship Types ─────────────────────────────────────

dea:Relationship a owl:Class ;
    rdfs:label "Relationship" .

dea:EcosystemActor a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "EcosystemActor" ;
    skos:definition "External party that actively exchanges value with the enterprise — supplier, customer, regulator, partner (OpenDEAM v0.2.0, L1)." ;
    dea:specification <schemas/entities/ecosystem-actor.json> .

dea:ValueExchange a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "ValueExchange" ;
    skos:definition "A flow of value between the enterprise and an ecosystem actor — information, goods, or funds; inbound or outbound (OpenDEAM v0.2.0, L1)." ;
    dea:specification <schemas/entities/value-exchange.json> .

dea:CollaborationAgreement a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "CollaborationAgreement" ;
    skos:definition "Terms governing cooperation with an ecosystem actor — cooperative or mandated (OpenDEAM v0.2.0, L1; moved from L2 by ADR-0002 D2)." ;
    dea:specification <schemas/entities/collaboration-agreement.json> .

dea:BusinessFunction a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "BusinessFunction" ;
    skos:definition "A grouping of business capabilities by organisational function; owned by an organizational unit (OpenDEAM v0.2.0, L3; CAP -> BF -> OU)." ;
    dea:specification <schemas/entities/business-function.json> .

dea:EcosystemPlatform a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "EcosystemPlatform" ;
    skos:definition "Standing multi-sided structure the enterprise hosts for repeated exchange among many third parties (L1, ADR-0003)." ;
    dea:specification <schemas/entities/ecosystem-platform.json> .

dea:Risk a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Risk" ;
    skos:definition "Condition or event threatening the enterprise's ability to persist or realise value (L2, ADR-0003)." ;
    dea:specification <schemas/entities/risk.json> .

dea:Control a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Control" ;
    skos:definition "Mechanism that mitigates a Risk or enforces a Regulation (L2, ADR-0003)." ;
    dea:specification <schemas/entities/control.json> .

dea:Regulation a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Regulation" ;
    skos:definition "Externally imposed obligation with force of law or contract (L2, ADR-0003)." ;
    dea:specification <schemas/entities/regulation.json> .

dea:Signal a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Signal" ;
    skos:definition "Weak or early indicator of environmental change (L2, ADR-0003)." ;
    dea:specification <schemas/entities/signal.json> .

dea:Experiment a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Experiment" ;
    skos:definition "Bounded, time-boxed test of a Signal's relevance (L2, ADR-0003)." ;
    dea:specification <schemas/entities/experiment.json> .

dea:TechnologyRadarEntry a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "TechnologyRadarEntry" ;
    skos:definition "Emerging technology tracked through assess/trial/adopt/hold (L2, ADR-0003)." ;
    dea:specification <schemas/entities/technology-radar-entry.json> .

dea:Skill a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Skill" ;
    skos:definition "Capability an individual Actor possesses or must develop (L3, ADR-0003)." ;
    dea:specification <schemas/entities/skill.json> .

dea:Role a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Role" ;
    skos:definition "Defined set of required Skills and responsibilities an Actor fulfills (L3, ADR-0003)." ;
    dea:specification <schemas/entities/role.json> .

dea:ChangeInitiative a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "ChangeInitiative" ;
    skos:definition "Deliberate effort to shift Skills, Roles, or culture (L3, ADR-0003)." ;
    dea:specification <schemas/entities/change-initiative.json> .

dea:ModelDeployment a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "ModelDeployment" ;
    skos:definition "Running instance of an AI/ML Model with operational lifecycle (L4, ADR-0003)." ;
    dea:specification <schemas/entities/model-deployment.json> .

dea:ModelFeedbackSignal a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "ModelFeedbackSignal" ;
    skos:definition "Drift/performance feedback from Events driving retraining (L4, ADR-0003)." ;
    dea:specification <schemas/entities/model-feedback-signal.json> .

dea:Resource a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Resource" ;
    skos:definition "Economic/physical substrate a bounded entity maintains to persist. Abstract category root carrying a completeness_contract (L3, ADR-0005)." ;
    dea:specification <schemas/entities/resource.json> .

dea:FinancialResource a owl:Class ;
    rdfs:subClassOf dea:Resource ;
    rdfs:label "FinancialResource" ;
    skos:definition "Liquid or near-liquid economic value the enterprise holds (L3, ADR-0005)." ;
    dea:specification <schemas/entities/financial-resource.json> .

dea:PhysicalResource a owl:Class ;
    rdfs:subClassOf dea:Resource ;
    rdfs:label "PhysicalResource" ;
    skos:definition "Tangible assets requiring an ongoing maintenance regime (L3, ADR-0005)." ;
    dea:specification <schemas/entities/physical-resource.json> .

dea:IntangibleResource a owl:Class ;
    rdfs:subClassOf dea:Resource ;
    rdfs:label "IntangibleResource" ;
    skos:definition "Legally protected non-physical economic value (L3, ADR-0005)." ;
    dea:specification <schemas/entities/intangible-resource.json> .

dea:InformationAsset a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "InformationAsset" ;
    skos:definition "Data given context and form for a specific consuming purpose (L4, ADR-0005)." ;
    dea:specification <schemas/entities/information-asset.json> .

dea:KnowledgeAsset a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "KnowledgeAsset" ;
    skos:definition "Applied know-how made explicit and durable, independent of any one Actor (L4, ADR-0005)." ;
    dea:specification <schemas/entities/knowledge-asset.json> .

# Object properties (CR-002: generated from the canonical relationship registry)

# Object properties (CR-002: generated from the canonical relationship registry)

# Object properties (CR-002: generated from the canonical relationship registry)

# Core ontology classes (CR-4)

dea:ArchitectureElement a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    dea:abstract true ;
    rdfs:label "ArchitectureElement" ;
    skos:definition "An identifiable element that participates in an architectural description of an enterprise (CR-4 §5). Not merely anything that appears in the repository." .

dea:Behavior a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    dea:abstract true ;
    rdfs:label "Behavior" ;
    skos:definition "Abstract concept for enterprise activity (CR-4 §9). Profiles specialize: Process, Activity, Workflow, BusinessFunction, AgentTask, Automation." .

dea:Service a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    dea:abstract true ;
    rdfs:label "Service" ;
    skos:definition "A means through which a provider exposes value or capability to a consumer without requiring the consumer to manage the underlying implementation (CR-4 §10)." .

dea:Information a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    dea:abstract true ;
    rdfs:label "Information" ;
    skos:definition "Abstract foundation for all information specializations (CR-4 §12). Profiles define DataEntity, BusinessObject, InformationAsset, KnowledgeAsset, DataProduct, Dataset." .

dea:Organization a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    dea:abstract true ;
    rdfs:label "Organization" ;
    skos:definition "Organizational structure, distinct from Actor agency (CR-4 §7). An organization can act as an Actor; structure and agency are different semantic concerns." .

dea:Decision a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Decision" ;
    skos:definition "A determination made by an Actor, system or Agent that selects or authorizes a course of action based on information, rules, objectives and constraints (CR-4 §13). Foundation for agentic architecture (CR-7)." .

dea:Outcome a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Outcome" ;
    skos:definition "A resulting state or value (CR-4 §14). Capability is an ability; Outcome is a result. Anchor for strategy, value, DMM, transformation and measurement." .

dea:Requirement a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Requirement" ;
    skos:definition "A stated need, obligation or condition that an architecture, solution, service or behavior must satisfy (CR-4 §15). Profiles specialize: business, regulatory, security, data, technology, AI." .

dea:Constraint a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Constraint" ;
    skos:definition "Something that limits the possible solution space (CR-4 §16). Distinct from Requirement: a Requirement must be satisfied; a Constraint limits options." .

dea:Change a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Change" ;
    skos:definition "A deliberate modification to enterprise capabilities, behavior, services, information, technology, organization or operating model (CR-4 §17). Foundation for transformation, roadmap, transition architecture and migration." .

dea:composes a owl:ObjectProperty ;
    rdfs:label "Composes" ;
    skos:definition "The target is structurally part of the source and normally has a dependent lifecycle (composition, section 14)." ;
    dea:category "structural" ;
    dea:inverseOf "dea:part-of" ;
    a owl:TransitiveProperty .

dea:aggregates a owl:ObjectProperty ;
    rdfs:label "Aggregates" ;
    skos:definition "The target participates in the source but retains an independent lifecycle (aggregation, section 14)." ;
    dea:category "structural" ;
    dea:inverseOf "dea:aggregated-in" .

dea:specializes a owl:ObjectProperty ;
    rdfs:label "Specializes" ;
    skos:definition "The source is a more specific form of the target (generalization/specialization hierarchy)." ;
    dea:category "structural" ;
    dea:inverseOf "dea:generalizes" ;
    a owl:TransitiveProperty .

dea:instantiates a owl:ObjectProperty ;
    rdfs:label "Instantiates" ;
    skos:definition "A concrete instance is created from a type or model (section 5)." ;
    dea:category "structural" ;
    dea:inverseOf "dea:instantiated-by" .

dea:realizes a owl:ObjectProperty ;
    rdfs:label "Realizes" ;
    skos:definition "The source architectural element provides the realization of an abstract capability, service, or outcome (section 5)." ;
    dea:category "realization" ;
    dea:inverseOf "dea:realized-by" .

dea:implements a owl:ObjectProperty ;
    rdfs:label "Implements" ;
    skos:definition "An implementation satisfies a specification, requirement, or design (section 5). Narrowed: not used for capability realization (use realizes) or technology enablement (use supports)." ;
    dea:category "realization" ;
    dea:inverseOf "dea:implemented-by" .

dea:operationalizes a owl:ObjectProperty ;
    rdfs:label "Operationalizes" ;
    skos:definition "A policy, tenet, or strategy is translated into operational practice (section 5)." ;
    dea:category "realization" ;
    dea:inverseOf "dea:operationalized-by" .

dea:dependsOn a owl:ObjectProperty ;
    rdfs:label "Depends On" ;
    skos:definition "The source requires the target for some purpose, without containment or realization semantics (section 14)." ;
    dea:category "dependency" ;
    dea:inverseOf "dea:depended-on-by" ;
    a owl:TransitiveProperty .

dea:requires a owl:ObjectProperty ;
    rdfs:label "Requires" ;
    skos:definition "The source cannot fulfil its definition without the target (mandatory dependency)." ;
    dea:category "dependency" ;
    dea:inverseOf "dea:required-by" .

dea:enables a owl:ObjectProperty ;
    rdfs:label "Enables" ;
    skos:definition "The source makes the target possible or materially more effective, without being required by it." ;
    dea:category "dependency" ;
    dea:inverseOf "dea:enabled-by" .

dea:constrains a owl:ObjectProperty ;
    rdfs:label "Constrains" ;
    skos:definition "The source limits the permissible design or behaviour space of the target." ;
    dea:category "dependency" ;
    dea:inverseOf "dea:constrained-by" .

dea:flowsTo a owl:ObjectProperty ;
    rdfs:label "Flows To" ;
    skos:definition "Information, material, control, or value moves from the source to the target." ;
    dea:category "flow" ;
    dea:inverseOf "dea:flows-from" .

dea:produces a owl:ObjectProperty ;
    rdfs:label "Produces" ;
    skos:definition "The source creates or emits the target as an output." ;
    dea:category "flow" ;
    dea:inverseOf "dea:produced-by" .

dea:consumes a owl:ObjectProperty ;
    rdfs:label "Consumes" ;
    skos:definition "The source takes the target as an input it uses up or processes." ;
    dea:category "flow" ;
    dea:inverseOf "dea:consumed-by" .

dea:exchanges a owl:ObjectProperty ;
    rdfs:label "Exchanges" ;
    skos:definition "The source and target participate in a bidirectional exchange of value, data, or signals." ;
    dea:category "flow" ;
    dea:inverseOf "dea:exchanges" ;
    a owl:SymmetricProperty .

dea:serves a owl:ObjectProperty ;
    rdfs:label "Serves" ;
    skos:definition "The source delivers value or service to the target party or channel." ;
    dea:category "serving" ;
    dea:inverseOf "dea:served-by" .

dea:provides a owl:ObjectProperty ;
    rdfs:label "Provides" ;
    skos:definition "The source makes the target service or capability available to consumers." ;
    dea:category "serving" ;
    dea:inverseOf "dea:provided-by" .

dea:uses a owl:ObjectProperty ;
    rdfs:label "Uses" ;
    skos:definition "The source consumes the target service or resource as offered (usage, not depletion — contrast consumes)." ;
    dea:category "serving" ;
    dea:inverseOf "dea:used-by" .

dea:exposes a owl:ObjectProperty ;
    rdfs:label "Exposes" ;
    skos:definition "The source presents the target as an accessible interface, product, or representation to consumers." ;
    dea:category "serving" ;
    dea:inverseOf "dea:exposed-via" .

dea:performs a owl:ObjectProperty ;
    rdfs:label "Performs" ;
    skos:definition "The source actor or organizational unit carries out the target process or function (section 12)." ;
    dea:category "execution" ;
    dea:inverseOf "dea:performed-by" .

dea:executes a owl:ObjectProperty ;
    rdfs:label "Executes" ;
    skos:definition "The source system function or component carries out the target process or activity automatically." ;
    dea:category "execution" ;
    dea:inverseOf "dea:executed-by" .

dea:orchestrates a owl:ObjectProperty ;
    rdfs:label "Orchestrates" ;
    skos:definition "The source coordinates the execution ordering and interaction of the targets." ;
    dea:category "execution" ;
    dea:inverseOf "dea:orchestrated-by" .

dea:triggers a owl:ObjectProperty ;
    rdfs:label "Triggers" ;
    skos:definition "The source event or signal initiates the target process, experiment, or retraining." ;
    dea:category "execution" ;
    dea:inverseOf "dea:triggered-by" .

dea:governs a owl:ObjectProperty ;
    rdfs:label "Governs" ;
    skos:definition "The source directs, constrains, or oversees the target through policy, agreement, or strategy." ;
    dea:category "governance" ;
    dea:inverseOf "dea:governed-by" .

dea:mandates a owl:ObjectProperty ;
    rdfs:label "Mandates" ;
    skos:definition "The source imposes a binding obligation on the target (regulatory or policy force)." ;
    dea:category "governance" ;
    dea:inverseOf "dea:mandated-by" .

dea:controls a owl:ObjectProperty ;
    rdfs:label "Controls" ;
    skos:definition "The source mitigates, protects against, or otherwise controls the target risk or exposure." ;
    dea:category "governance" ;
    dea:inverseOf "dea:controlled-by" .

dea:owns a owl:ObjectProperty ;
    rdfs:label "Owns" ;
    skos:definition "The source holds ownership of the target — accountability for its lifecycle and value." ;
    dea:category "governance" ;
    dea:inverseOf "dea:owned-by" .

dea:accountableFor a owl:ObjectProperty ;
    rdfs:label "Accountable For" ;
    skos:definition "The source holds single-point accountability for the target (RACI 'A')." ;
    dea:category "governance" ;
    dea:inverseOf "dea:accountable-to" .

dea:responsibleFor a owl:ObjectProperty ;
    rdfs:label "Responsible For" ;
    skos:definition "The source performs or manages the target day-to-day (RACI 'R'), including custodianship and role fulfilment." ;
    dea:category "governance" ;
    dea:inverseOf "dea:responsible-to" .

dea:threatens a owl:ObjectProperty ;
    rdfs:label "Threatens" ;
    skos:definition "The source risk exposes the target to potential harm or failure (risk relation, section 17 placement per D5)." ;
    dea:category "governance" ;
    dea:inverseOf "dea:threatened-by" .

dea:represents a owl:ObjectProperty ;
    rdfs:label "Represents" ;
    skos:definition "One information representation corresponds to another conceptual entity (section 5)." ;
    dea:category "information" ;
    dea:inverseOf "dea:represented-by" .

dea:informs a owl:ObjectProperty ;
    rdfs:label "Informs" ;
    skos:definition "The source provides knowledge, evidence, or meaning that shapes the target (incl. semantic definition and weak influence — section 17)." ;
    dea:category "information" ;
    dea:inverseOf "dea:informed-by" .

dea:curates a owl:ObjectProperty ;
    rdfs:label "Curates" ;
    skos:definition "The source selects, organizes, and maintains the target as governed content or product." ;
    dea:category "information" ;
    dea:inverseOf "dea:curated-into" .

dea:publishes a owl:ObjectProperty ;
    rdfs:label "Publishes" ;
    skos:definition "The source makes the target event or information available to subscribers." ;
    dea:category "information" ;
    dea:inverseOf "dea:published-by" .

dea:subscribesTo a owl:ObjectProperty ;
    rdfs:label "Subscribes To" ;
    skos:definition "The source consumes publications of the target event or information feed." ;
    dea:category "information" ;
    dea:inverseOf "dea:subscribed-by" .

dea:trainedOn a owl:ObjectProperty ;
    rdfs:label "Trained On" ;
    skos:definition "The source AI/ML model is trained on the target data product or dataset." ;
    dea:category "information" ;
    dea:inverseOf "dea:training-of" .

dea:derivedFrom a owl:ObjectProperty ;
    rdfs:label "Derived From" ;
    skos:definition "The source is derived from the target information, event, or actor knowledge (lineage)." ;
    dea:category "information" ;
    dea:inverseOf "dea:derived-into" ;
    a owl:TransitiveProperty .

dea:assessedBy a owl:ObjectProperty ;
    rdfs:label "Assessed By" ;
    skos:definition "The source is evaluated by the target assessment instrument, experiment, or framework." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:assesses" .

dea:measuredBy a owl:ObjectProperty ;
    rdfs:label "Measured By" ;
    skos:definition "The source's performance, health, or maturity is quantified by the target metric." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:measures" .

dea:evidencedBy a owl:ObjectProperty ;
    rdfs:label "Evidenced By" ;
    skos:definition "The source relationship or claim is supported by the target evidence artefact (section 6)." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:evidences" .

dea:benchmarkedAgainst a owl:ObjectProperty ;
    rdfs:label "Benchmarked Against" ;
    skos:definition "The source is compared against the target reference, standard, or peer." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:benchmark-of" .

dea:transitionsTo a owl:ObjectProperty ;
    rdfs:label "Transitions To" ;
    skos:definition "The source evolves into the target state, maturity, or technology over time (CR-6 will add temporal semantics)." ;
    dea:category "transformation" ;
    dea:inverseOf "dea:transitions-from" .

dea:replaces a owl:ObjectProperty ;
    rdfs:label "Replaces" ;
    skos:definition "The source takes over the function of the target, which is retired." ;
    dea:category "transformation" ;
    dea:inverseOf "dea:replaced-by" .

dea:supersedes a owl:ObjectProperty ;
    rdfs:label "Supersedes" ;
    skos:definition "The source version or concept supersedes the target in definition or governance." ;
    dea:category "transformation" ;
    dea:inverseOf "dea:superseded-by" .

dea:migratesTo a owl:ObjectProperty ;
    rdfs:label "Migrates To" ;
    skos:definition "The source is moved to the target platform, component, or state during a change initiative." ;
    dea:category "transformation" ;
    dea:inverseOf "dea:migrated-from" .

dea:mapsTo a owl:ObjectProperty ;
    rdfs:label "Maps To" ;
    skos:definition "An explicit crosswalk or correspondence between two modelling systems or classification schemes (section 9). NOT a generic 'somehow related'." ;
    dea:category "traceability" ;
    dea:inverseOf "dea:mapped-from" .

dea:tracesTo a owl:ObjectProperty ;
    rdfs:label "Traces To" ;
    skos:definition "Audit lineage from the source to the target artefact that justifies or originates it." ;
    dea:category "traceability" ;
    dea:inverseOf "dea:traced-from" ;
    a owl:TransitiveProperty .

dea:supports a owl:ObjectProperty ;
    rdfs:label "Supports" ;
    skos:definition "The source contributes to the target's function, funding, or effectiveness without realizing, enabling, or being required by it." ;
    dea:category "dependency" ;
    dea:inverseOf "dea:supported-by" .

dea:makes a owl:ObjectProperty ;
    rdfs:label "Makes" ;
    skos:definition "An Actor or Organization makes (authors/commits to) a Decision (CR-4 §13/§20)." ;
    dea:category "governance" ;
    dea:inverseOf "dea:made-by" .

dea:resultsIn a owl:ObjectProperty ;
    rdfs:label "Results In" ;
    skos:definition "A Decision or Change produces an Outcome (CR-4 §13/§17)." ;
    dea:category "transformation" ;
    dea:inverseOf "dea:resulting-from" .

dea:targets a owl:ObjectProperty ;
    rdfs:label "Targets" ;
    skos:definition "A Decision or Change intends an Outcome (CR-4 §14). Resolves the parked CR-2 targets label: ChangeInitiative change-scope uses dea:affects." ;
    dea:category "governance" ;
    dea:inverseOf "dea:targeted-by" .

dea:affects a owl:ObjectProperty ;
    rdfs:label "Affects" ;
    skos:definition "A Change modifies the state of an architectural element (CR-4 §17). Broad endpoint by design; profiles constrain further." ;
    dea:category "transformation" ;
    dea:inverseOf "dea:affected-by" .

dea:contributesTo a owl:ObjectProperty ;
    rdfs:label "Contributes To" ;
    skos:definition "Partial causal contribution: a BusinessFunction contributes to a Capability; a Capability contributes to an Outcome (CR-4 §8/§14)." ;
    dea:category "realization" ;
    dea:inverseOf "dea:contributed-to-by" .

# ═══ CR-5: Assessment profile classes ═══

dea:Assessment a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Assessment" ;
    skos:definition "A structured evaluation of one or more subjects against an assessment framework at a defined point or period in time (CR-5 §4). The evaluation event — never an attribute of the subject." .

dea:AssessmentFramework a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentFramework" ;
    skos:definition "The external methodology used to conduct an assessment — its dimensions, criteria, indicators, scoring, maturity model and evidence requirements (CR-5 §5). External to the subject being assessed and versioned independently of OpenDEA Core (CR-5 §33)." .

dea:AssessmentDimension a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentDimension" ;
    skos:definition "A structured perspective through which a subject is evaluated (CR-5 §6). An assessment perspective, not an architectural entity: a DMM dimension never becomes equivalent to the DEA entities it assesses." .

dea:AssessmentCriterion a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentCriterion" ;
    skos:definition "Defines what is evaluated within a dimension — id, name, definition, applicability and evaluation guidance (CR-5 §7). A criterion never contains the result of an evaluation." .

dea:Indicator a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Indicator" ;
    skos:definition "The observable signal used to evaluate a criterion (CR-5 §8). Criterion = what we evaluate; Indicator = what we observe; Measure = what we quantify; Result = what was assessed." .

dea:Observation a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Observation" ;
    skos:definition "A raw measured or observed fact collected as input to assessment (CR-5 §27), e.g. '78% of applications have documented architecture'. Distinct from the derived result it may inform." .

dea:Measure a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Measure" ;
    skos:definition "A quantifiable observation of an indicator — value, unit, observation time and source (CR-5 §9). The unit is referenced, never encoded into the entity name." .

dea:Score a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Score" ;
    skos:definition "A numerical or ordinal evaluation derived from measures against a declared scale (CR-5 §11). A score is not intrinsically a maturity level; the framework defines the transformation." .

dea:Scale a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Scale" ;
    skos:definition "A declared ordered value space for scores and measures (CR-5 Phase 2; A004) — e.g. a 0..1 ratio or a 1..5 ordinal range." .

dea:Unit a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Unit" ;
    skos:definition "A standard quantity in which a measure is expressed (CR-5 §9/Phase 2) — percent, ratio, months, currency, count. Referenced by measures; never embedded in names." .

dea:AssessmentResult a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentResult" ;
    skos:definition "The central object connecting assessment to architecture (CR-5 §10): subject, criterion, score or maturity level, evidence, confidence, assessor, framework and temporal anchors. A result never modifies the identity of the assessed entity (A007)." .

dea:AssessmentSubject a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentSubject" ;
    skos:definition "The thing being evaluated — a reference to a DEA entity at an explicit scope (CR-5 §14). Allows the same entity to be assessed at different organizational scopes." .

dea:AssessmentScope a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentScope" ;
    skos:definition "The explicit boundary of an assessment (CR-5 §15), modeled as references to actual enterprise entities wherever possible rather than free-text labels." .

dea:AssessmentTarget a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentTarget" ;
    skos:definition "A desired future value or maturity level for a subject and criterion, with target date, rationale and approver (CR-5 §21). Targets live in the assessment layer — never on the architectural entity." .

dea:AssessmentGap a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AssessmentGap" ;
    skos:definition "The derived difference between a current result and a target (CR-5 §30). Gaps are derived, never authoritative source data; the authoritative data are current state and target state. Gaps connect assessment to transformation via addressed-by → Change (CR-5 §31)." .

dea:MaturityModel a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "MaturityModel" ;
    skos:definition "An ordered set of maturity levels defined, governed and versioned by an assessment framework (CR-5 §12/§33). Maturity belongs to the framework, not to any architectural entity (CR-5 §13)." .

dea:MaturityLevel a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "MaturityLevel" ;
    skos:definition "A named, ordered position within a maturity model (CR-5 §12). Belongs to the referenced maturity model (A005); results attain levels — entities never carry them intrinsically (A008)." .

dea:MaturityScale a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "MaturityScale" ;
    skos:definition "The scale over which a maturity model's levels are defined (CR-5 §12), e.g. a 1..5 ordered range." .

dea:MaturityRule a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "MaturityRule" ;
    skos:definition "A framework-defined rule mapping scores or measures to maturity levels, including gating criteria and maturity ceilings (CR-5 §12/§26)." .

dea:AggregationRule a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "AggregationRule" ;
    skos:definition "Declares how lower-level results combine into higher-level results (CR-5 §25): weighted averages, minimum thresholds, gating criteria, ceilings, qualitative judgement, evidence sufficiency or rule-based scoring. Never assumed to be a simple arithmetic mean (A009)." .

dea:ScoringRule a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "ScoringRule" ;
    skos:definition "Declares how measures become scores within a framework (CR-5 §11/§25). The framework — not the ontology — defines the transformation." .

dea:MaturityMappingRule a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "MaturityMappingRule" ;
    skos:definition "Declares how scores map to maturity levels within a framework (CR-5 §11/§25): Measure → Score → Scoring Rule → Maturity Level." .

dea:Evidence a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Evidence" ;
    skos:definition "First-class support for an assessment result (CR-5 §16): document, inventory, interview, survey, metric, audit report, process observation, system log, API measurement or control test — with provenance, validity and confidence. Evidence supports a result; it is not the result (CR-5 §17)." .

dea:EvidenceSource a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "EvidenceSource" ;
    skos:definition "The origin from which evidence is collected (CR-5 §16): a system, document store, interview programme, survey instrument, audit, log pipeline or API endpoint." .

dea:EvidenceArtifact a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "EvidenceArtifact" ;
    skos:definition "A concrete artifact referenced as evidence (CR-5 §16): an architecture document, system inventory, audit report, log extract or control test record." .

dea:Benchmark a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "Benchmark" ;
    skos:definition "A comparative reference external to the enterprise's own assessment (CR-5 §28). Benchmarking is modeled separately from assessment: AssessmentResult ≠ Benchmark and AssessmentTarget ≠ Benchmark (A011)." .

dea:BenchmarkPopulation a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "BenchmarkPopulation" ;
    skos:definition "The peer or industry population over which a benchmark is computed (CR-5 §28)." .

dea:BenchmarkReference a owl:Class ;
    rdfs:subClassOf dea:Entity ;
    rdfs:label "BenchmarkReference" ;
    skos:definition "A specific comparative value drawn from a benchmark population (CR-5 §28): industry level, peer median, percentile. Compared against results via benchmarked-against — never treated as a result (A011)." .

# ═══ CR-5: Assessment profile object properties ═══

dea:assesses a owl:ObjectProperty ;
    rdfs:label "Assesses" ;
    skos:definition "The source assessment construct evaluates the target subject against a framework (CR-5 §4/§10/§23). DMM dimensions assess DEA concepts rather than replacing them." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:assessed-by" .

dea:conductedUnder a owl:ObjectProperty ;
    rdfs:label "Conducted Under" ;
    skos:definition "An Assessment is conducted under exactly one AssessmentFramework (CR-5 §5; A001)." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:governs-assessment" .

dea:defines a owl:ObjectProperty ;
    rdfs:label "Defines" ;
    skos:definition "An AssessmentFramework or MaturityModel declares the target element as part of its methodology (CR-5 §5/§12) — dimensions, criteria, indicators, levels, scales and rules." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:defined-by" .

dea:quantifies a owl:ObjectProperty ;
    rdfs:label "Quantifies" ;
    skos:definition "A Measure quantifies an Indicator or Observation (CR-5 §9/§27): Observation → Measure in the result chain." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:quantified-by" .

dea:derivesFrom a owl:ObjectProperty ;
    rdfs:label "Derives From" ;
    skos:definition "The source is derived from the target: Score from Measure (CR-5 §11), AssessmentGap from current result and target (CR-5 §30), BenchmarkReference from Benchmark (CR-5 §28). Derived objects are never authoritative source data." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:feeds" .

dea:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "Evaluated By" ;
    skos:definition "An AssessmentResult is produced under a declared AggregationRule or ScoringRule (CR-5 §26; A009) — arithmetic is never hard-coded into the ontology." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:evaluates" .

dea:mapsTo a owl:ObjectProperty ;
    rdfs:label "Maps To" ;
    skos:definition "A ScoringRule, MaturityMappingRule or MaturityRule maps values onto MaturityLevels or Scales (CR-5 §11/§25): the framework defines the score→maturity transformation." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:mapped-from" .

dea:attains a owl:ObjectProperty ;
    rdfs:label "Attains" ;
    skos:definition "An AssessmentResult attains a MaturityLevel, or an AssessmentTarget sets one as goal (CR-5 §13). Maturity is attributed through results, never stored on the architectural entity (A008)." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:attained-by" .

dea:addressedBy a owl:ObjectProperty ;
    rdfs:label "Addressed By" ;
    skos:definition "An AssessmentGap is addressed by a Change or ChangeInitiative (CR-5 §31): Assessment → Current State → Gap → Required Change → Target Architecture → Outcome." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:addresses" .

dea:benchmarkedAgainst a owl:ObjectProperty ;
    rdfs:label "Benchmarked Against" ;
    skos:definition "An AssessmentResult is compared with a BenchmarkReference (CR-5 §28). A benchmark is never an assessment result (A011)." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:benchmark-for" .

dea:scopedBy a owl:ObjectProperty ;
    rdfs:label "Scoped By" ;
    skos:definition "An Assessment or AssessmentSubject is bounded by an explicit AssessmentScope (CR-5 §15)." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:scopes" .

dea:refersTo a owl:ObjectProperty ;
    rdfs:label "Refers To" ;
    skos:definition "Generic reference from an assessment-layer object to a DEA entity (CR-5 §14/§15/§16): subjects and scopes reference actual enterprise entities rather than free-text labels." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:referenced-by" .

dea:originatesFrom a owl:ObjectProperty ;
    rdfs:label "Originates From" ;
    skos:definition "Evidence, EvidenceArtifacts, Measures and Observations originate from a declared EvidenceSource (CR-5 §16/§19 provenance)." ;
    dea:category "assessment" ;
    dea:inverseOf "dea:origin-of" .

